<%- include('partials/header') %>

<div class="auth-container">
    <h2 class="text-center">Welcome back</h2>
    
    <% if (error) { %>
        <div class="error-msg"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" required autofocus>
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn" style="width: 100%; margin-top: 8px;">Sign In</button>
    </form>
    
    <p class="text-center" style="margin-top: 20px; font-size: 0.9rem;">
        No account? <a href="/register" style="text-decoration: underline;">Create one</a>
    </p>
</div>
</body></html>